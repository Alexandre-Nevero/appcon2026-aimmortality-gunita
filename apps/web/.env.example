# Better Auth (required to initialize auth at all, including at build time — see src/auth/auth.ts)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Visitor IP hashing on public /m/[token] pages (see src/memories/visitor.ts)
IP_HASH_SECRET=

# Neon Postgres (pooled connection, used by the app at runtime)
DATABASE_URL=

# Neon Postgres (unpooled/direct connection, used by drizzle-kit for migrations)
DATABASE_URL_UNPOOLED=

# Vercel Blob (source uploads)
BLOB_READ_WRITE_TOKEN=

# AI providers (docs/ops.md § Configuration & secrets)
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Privileged deep health checks (docs/ops.md § Observability)
HEALTH_CHECK_SECRET=
HEALTH_CHECK_SPACE_ID=

# Provider model IDs — swap without a code change (apps/web/src/ai/models.ts falls back to the
# System Design picks if these are unset)
MODEL_TRANSCRIBE=
MODEL_TEXT=
MODEL_TEXT_FALLBACK=
MODEL_VISION=
MODEL_EMBED=
